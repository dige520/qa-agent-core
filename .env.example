# Google Gemini API Key (用于 3072 维语义向量生成)
GOOGLE_API_KEY=your_google_api_key_here
EMBEDDING_MODEL=gemini-embedding-2

# 混合检索加权参数 (向量 + BM25 归一化比例)
RERANK_WEIGHT_VECTOR=0.7
RERANK_WEIGHT_BM25=0.3

# 自定义持久化目录 (可选，默认落入模块内置 data 目录)
# RAG_DATA_DIR=/path/to/data
# CHROMA_DB_DIR=/path/to/chroma_db
# BM25_INDEX_FILE=/path/to/bm25_corpus.json
# MANIFEST_FILE=/path/to/manifest.json
